.env
node_modules/
dist/
*.js.map
*.txt
# Исключение из *.txt: robots.txt раздаётся публично и должен быть в репозитории
!static/robots.txt
docker-compose.local.yml
.env.local*

# Локальный запуск: сам скрипт и его рантайм-файлы
run.sh
run.log
.run.pid

# Vite build output, пересобирается через yarn build:frontend
frontend-dist/

# Исходные материалы, в рантайме не используются
temp/

# Пользовательские загрузки и результаты генераций (bind-mount в контейнер)
uploads/*
!uploads/.gitkeep
